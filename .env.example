# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA-replace-me

# Comma-separated Telegram user IDs of admins (get yours from @userinfobot)
ADMIN_IDS=123456789

# Path to SQLite database file (relative or absolute)
DB_PATH=data/shop.sqlite3

# Where uploaded payment proof screenshots are stored
PROOFS_DIR=data/proofs

# Shop display name (shown in /start)
SHOP_NAME=Цифровой магазин

# Payment instructions shown to buyer after they pick a product.
# Multi-line via \n. Will be wrapped in <pre> in the bot message.
PAYMENT_INSTRUCTIONS=Переведите сумму на карту:\n5536 0000 0000 0000 (Тинькофф, Иван И.)\nИли по СБП по номеру +7 900 000-00-00\nПосле оплаты пришлите сюда скриншот чека.

# Optional: support contact shown to user (e.g. @your_username)
SUPPORT_CONTACT=@your_username
